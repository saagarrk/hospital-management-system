{
  "info": {
    "name": "MedPulse Hospital Management System - REST API",
    "description": "Comprehensive Postman test collection for Spring Boot 3.x REST API with JWT Auth, Role-Based Access Control, and SRS Business Rules enforcement.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login - Admin",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"admin\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"]}
          }
        },
        {
          "name": "Login - Doctor",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"doctor_cardio\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"]}
          }
        }
      ]
    },
    {
      "name": "2. Appointments (SRS Rule 1 & 2)",
      "item": [
        {
          "name": "Book Appointment (Valid)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{jwtToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 1,\n  \"doctorId\": 1,\n  \"appointmentDate\": \"2026-10-15\",\n  \"appointmentTime\": \"10:00:00\",\n  \"reason\": \"Routine cardiac examination\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/appointments", "host": ["{{baseUrl}}"], "path": ["api", "appointments"]}
          }
        },
        {
          "name": "Book Conflicting Slot (Expect HTTP 409 Conflict - Rule 1)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{jwtToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 2,\n  \"doctorId\": 1,\n  \"appointmentDate\": \"2026-10-15\",\n  \"appointmentTime\": \"10:00:00\",\n  \"reason\": \"Duplicate booking test\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/appointments", "host": ["{{baseUrl}}"], "path": ["api", "appointments"]}
          }
        }
      ]
    },
    {
      "name": "3. Pharmacy (SRS Rule 5 & 12)",
      "item": [
        {
          "name": "Dispense Expired Drug (Expect HTTP 400 - Rule 12)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{jwtToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/pharmacy/medicines/4/dispense", "host": ["{{baseUrl}}"], "path": ["api", "pharmacy", "medicines", "4", "dispense"]}
          }
        }
      ]
    },
    {
      "name": "4. Inpatient & Beds (SRS Rule 7, 8, 10)",
      "item": [
        {
          "name": "Admit to Occupied Bed (Expect HTTP 409 Conflict - Rule 7)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{jwtToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 2,\n  \"doctorId\": 1,\n  \"bedId\": 1,\n  \"reasonForAdmission\": \"Emergency ICU observation\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/inpatient/admissions", "host": ["{{baseUrl}}"], "path": ["api", "inpatient", "admissions"]}
          }
        }
      ]
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "jwtToken", "value": "YOUR_JWT_TOKEN_HERE"}
  ]
}
